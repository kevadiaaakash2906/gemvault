# Copy this file to .env.local on your own computer (never commit .env.local).
# On Vercel, add these same names under Project > Settings > Environment Variables.

# Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase > Project Settings > API Keys > "Publishable key" (safe for the browser).
# NEVER put the "secret" or "service_role" key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# The public web address of your site (no trailing slash).
# Local: http://localhost:3000   Online: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
